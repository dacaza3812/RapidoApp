{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "llama.cpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama-server (local)",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1",
        "apiKey": "sk-local"
      },
      "models": {
        "lfm2-2.6b-exp": {
          "name": "LiquidAI LFM2-2.6B Exp (local CPU)",
          "limit": {
            "context": 16384,
            "output": 2048
          }
        }
      }
    }
  }
}
